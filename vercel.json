{
  "version": 2,
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "functions": {
    "api/auth.js": {
      "maxDuration": 15
    },
    "api/chat.js": {
      "maxDuration": 60
    },
    "api/gallery.js": {
      "maxDuration": 10
    },
    "api/x402.js": {
      "maxDuration": 60
    },
    "api/aeon.js": {
      "maxDuration": 15
    },
    "api/launch.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/download/orlix-keyboard.apk",
      "destination": "https://github.com/AureliusAI-code/orlix/releases/latest/download/orlix-keyboard.apk",
      "permanent": false
    },
    {
      "source": "/keyboard.apk",
      "destination": "https://github.com/AureliusAI-code/orlix/releases/latest/download/orlix-keyboard.apk",
      "permanent": false
    },
    {
      "source": "/app.html",
      "destination": "/app",
      "permanent": true
    },
    {
      "source": "/docs.html",
      "destination": "/docs",
      "permanent": true
    },
    {
      "source": "/api-docs.html",
      "destination": "/docs/api",
      "permanent": true
    },
    {
      "source": "/changelog.html",
      "destination": "/changelog",
      "permanent": true
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/terms.html",
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/song",
      "destination": "/app#song",
      "permanent": false
    },
    {
      "source": "/gallery",
      "destination": "/app#gallery",
      "permanent": false
    },
    {
      "source": "/gallery.html",
      "destination": "/app#gallery",
      "permanent": true
    },
    {
      "source": "/song.html",
      "destination": "/app#song",
      "permanent": true
    },
    {
      "source": "/zero.html",
      "destination": "/zero",
      "permanent": true
