    {
      "source": "/dashboard.html",
      "destination": "/dashboard",
      "permanent": true
    },
    {
      "source": "/cotty.html",
      "destination": "/cotty",
      "permanent": true
    },
    {
      "source": "/nft.html",
      "destination": "/nft",
      "permanent": true
    },
    {
      "source": "/agents.html",
      "destination": "/agents",
      "permanent": true
    },
    {
      "source": "/amm.html",
      "destination": "/amm",
      "permanent": true
    },
    {
      "source": "/seed.html",
      "destination": "/seed",
      "permanent": true
    },
    {
