      "destination": "/floor",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/x402-chat",
      "destination": "/api/x402?service=chat"
    },
    {
      "source": "/api/x402-market",
      "destination": "/api/x402?service=market"
    },
    {
      "source": "/api/token-search",
      "destination": "/api/search?__svc=ts"
    },
    {
      "source": "/api/bankr-tokens",
      "destination": "/api/search?__svc=bankr"
    },
    {
