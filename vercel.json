{
  "version": 2,
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",  "value": "nosniff" },
        { "key": "X-Frame-Options",          "value": "DENY" },
        { "key": "Referrer-Policy",          "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",       "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security","value": "max-age=63072000; includeSubDomains" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    }
  ],
  "functions": {
    "api/auth.js":         { "maxDuration": 15 },
    "api/chat.js":         { "maxDuration": 60 },
    "api/gallery.js":      { "maxDuration": 10 },
    "api/b20-skill.js":    { "maxDuration": 30 },
    "api/b20-tokens.js":   { "maxDuration": 15 },
    "api/b20-ai.js":       { "maxDuration": 20 },
    "api/x402.js":         { "maxDuration": 60 },
    "api/aeon.js":         { "maxDuration": 15 }
  },
  "redirects": [
    { "source": "/app.html",          "destination": "/app",          "permanent": true },
    { "source": "/docs.html",         "destination": "/docs",         "permanent": true },
    { "source": "/api-docs.html",     "destination": "/docs/api",     "permanent": true },
    { "source": "/changelog.html",    "destination": "/changelog",    "permanent": true },
    { "source": "/privacy.html",      "destination": "/privacy",      "permanent": true },
    { "source": "/terms.html",        "destination": "/terms",        "permanent": true },
    { "source": "/song",               "destination": "/app#song",     "permanent": false },
    { "source": "/gallery",           "destination": "/app#gallery",  "permanent": false },
    { "source": "/gallery.html",      "destination": "/app#gallery",  "permanent": true },
    { "source": "/token.html",        "destination": "/token",        "permanent": true },
    { "source": "/song.html",         "destination": "/app#song",     "permanent": true },
    { "source": "/b20-studio.html",    "destination": "/b20",           "permanent": true },
    { "source": "/b20-names.html",     "destination": "/names",         "permanent": true },
    { "source": "/b20-demo.html",     "destination": "/b20-demo",      "permanent": true },
    { "source": "/neural-map.html",   "destination": "/base-city",     "permanent": true },
    { "source": "/neural-map",        "destination": "/base-city",     "permanent": true },
    { "source": "/zero.html",         "destination": "/zero",          "permanent": true },
    { "source": "/dashboard.html",    "destination": "/dashboard",     "permanent": true },
    { "source": "/cotty.html",        "destination": "/cotty",         "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/x402-chat",    "destination": "/api/x402?service=chat" },
    { "source": "/api/x402-b20",     "destination": "/api/x402?service=b20" },
    { "source": "/api/x402-market",  "destination": "/api/x402?service=market" },
    { "source": "/api/b20-market",   "destination": "/api/b20-tokens?__svc=market" },
    { "source": "/api/token-search", "destination": "/api/search?__svc=ts" },
    { "source": "/api/bankr-tokens", "destination": "/api/search?__svc=bankr" },
    { "source": "/api/b20",          "destination": "/api/b20-ai?__svc=info" },
    { "source": "/app",          "destination": "/app.html" },
    { "source": "/docs",         "destination": "/docs.html" },
    { "source": "/docs/api",     "destination": "/api-docs.html" },
    { "source": "/changelog",    "destination": "/changelog.html" },
    { "source": "/privacy",      "destination": "/privacy.html" },
    { "source": "/terms",        "destination": "/terms.html" },
    { "source": "/token",        "destination": "/token.html" },
    { "source": "/b20",          "destination": "/b20-studio.html" },
    { "source": "/names",        "destination": "/b20-names.html" },
    { "source": "/policy",       "destination": "/b20-policy.html" },
    { "source": "/policy-lab",   "destination": "/b20-policy.html" },
    { "source": "/montage",      "destination": "/montage.html" },
    { "source": "/base-city",     "destination": "/neural-map.html" },
    { "source": "/zero",          "destination": "/zero.html" },
    { "source": "/mission-control", "destination": "/mission-control.html" },
    { "source": "/dashboard",       "destination": "/dashboard.html" },
    { "source": "/cotty",           "destination": "/cotty.html" }
  ]
}
